<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="stylesheet" href="/styles.css">
  </head>

  <body class="min-h-screen bg-slate-950 text-white">

    <header class="border-b border-slate-800 bg-slate-950">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
        <a href="/" class="text-2xl font-black tracking-tight">
          Game<span class="text-cyan-400">Vault</span>
        </a>

        <nav class="flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/" class="transition hover:text-cyan-400">
            Games
          </a>

          <a href="/categories" class="transition hover:text-cyan-400">
            Categories
          </a>

          <a
            href="/games/new"
            class="rounded-lg bg-cyan-400 px-4 py-2 font-bold text-slate-950 transition hover:bg-cyan-300"
          >
            Add Game
          </a>

          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle light and dark theme"
            class="rounded-lg border border-slate-700 px-3 py-2 text-lg transition hover:border-cyan-400"
          >
            <span id="theme-icon">☀️</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-6 py-12">

      <section class="mb-10">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-cyan-400">
          Your game collection
        </p>

        <h1 class="text-4xl font-black tracking-tight sm:text-5xl">
          Browse the inventory
        </h1>

        <p class="mt-4 max-w-2xl text-lg text-slate-400">
          Explore all games currently available in the store.
        </p>
      </section>

      <section class="mb-10">
        <h2 class="mb-4 text-lg font-bold text-slate-200">
          Browse by category
        </h2>

        <div class="flex flex-wrap gap-3">

          <a
            href="/"
            class="<%= !selectedCategory
              ? 'bg-cyan-400 text-slate-950'
              : 'border border-slate-700 text-slate-300 hover:border-cyan-400 hover:text-cyan-400'
            %> rounded-lg px-4 py-2 text-sm font-bold transition"
          >
            All
          </a>

          <% categories.forEach((category) => { %>
            <a
              href="/?category=<%= category.id %>"
              class="<%= selectedCategory == category.id
                ? 'bg-cyan-400 text-slate-950'
                : 'border border-slate-700 text-slate-300 hover:border-cyan-400 hover:text-cyan-400'
              %> rounded-lg px-4 py-2 text-sm font-bold transition"
            >
              <%= category.title %>
            </a>
          <% }) %>

        </div>
      </section>

      <% if (games.length === 0) { %>

        <section class="rounded-xl border border-dashed border-slate-700 p-12 text-center">
          <h2 class="text-2xl font-bold">
            No games found
          </h2>

          <p class="mt-3 text-slate-400">
            There are no games in this category yet.
          </p>

          <a
            href="/"
            class="mt-6 inline-block rounded-lg bg-cyan-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-cyan-300"
          >
            View all games
          </a>
        </section>

      <% } else { %>

        <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

          <% games.forEach((game) => { %>

            <article
              class="group overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-xl transition duration-300 hover:-translate-y-2 hover:border-cyan-400/70 hover:shadow-cyan-400/10"
            >

              <a href="/games/<%= game.id %>">

                <% if (game.cover_image) { %>
                  <img
                    src="<%= game.cover_image %>"
                    alt="Cover image for <%= game.title %>"
                    class="h-72 w-full object-cover transition duration-500 group-hover:scale-105"
                  >
                <% } else { %>
                  <div
                    class="flex h-72 items-center justify-center bg-slate-800 text-sm font-medium text-slate-500"
                  >
                    No cover image
                  </div>
                <% } %>

              </a>

              <div class="p-5">

                <p class="text-xs font-bold uppercase tracking-widest text-cyan-400">
                  <%= game.category_title %>
                </p>

                <h2 class="mt-2 text-xl font-bold">
                  <a
                    href="/games/<%= game.id %>"
                    class="transition hover:text-cyan-400"
                  >
                    <%= game.title %>
                  </a>
                </h2>

                <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-400">
                  <%= game.description %>
                </p>

                <div class="mt-6 flex items-center justify-between">
                  <span class="text-lg font-black">
                    $<%= Number(game.price).toFixed(2) %>
                  </span>

                  <a
                    href="/games/<%= game.id %>"
                    class="rounded-lg border border-slate-700 px-3 py-2 text-sm font-bold text-slate-300 transition hover:border-cyan-400 hover:text-cyan-400"
                  >
                    Details
                  </a>
                </div>

              </div>
            </article>

          <% }) %>

        </section>

      <% } %>

    </main>

  </body>

  <script>
    const savedTheme = localStorage.getItem("theme");
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const isDark = savedTheme ? savedTheme === "dark" : prefersDark;

    document.documentElement.classList.toggle("dark", isDark);

    const themeToggle = document.getElementById("theme-toggle");
    const themeIcon = document.getElementById("theme-icon");

    function updateThemeIcon() {
      const darkMode = document.documentElement.classList.contains("dark");
      themeIcon.textContent = darkMode ? "☀️" : "🌙";
      themeToggle.setAttribute(
        "aria-label",
        darkMode ? "Switch to light theme" : "Switch to dark theme"
      );
    }

    updateThemeIcon();

    themeToggle.addEventListener("click", () => {
      const darkMode = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", darkMode ? "dark" : "light");
      updateThemeIcon();
    });
  </script>
</html>
